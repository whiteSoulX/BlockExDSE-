# Edge node image — also what Render/Railway build directly from when
# deploying each of the 3 edge nodes as a separate cloud service.
FROM python:3.12-slim

WORKDIR /app

COPY edge/requirements.txt ./edge/requirements.txt
RUN pip install --no-cache-dir -r edge/requirements.txt

COPY edge/ ./edge/
COPY dashboard/ ./dashboard/

ENV PYTHONUNBUFFERED=1
EXPOSE 9001

CMD ["python", "edge/edge_node.py"]
