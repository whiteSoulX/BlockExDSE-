# Copy to .env and fill in before deploying to a public testnet.
# .env is gitignored — never commit real keys.

# RPC endpoint for the Sepolia testnet (Alchemy, Infura, or any provider's
# free tier both work). Used by hardhat.config.js's `sepolia` network.
SEPOLIA_RPC_URL=

# Private key of the account that deploys the contract and acts as
# delegate #1 (the primary edge node). Fund this address with Sepolia ETH
# from a faucet before deploying — see README "Public testnet deployment".
# NEVER use an account that holds real funds on any network.
DEPLOYER_PRIVATE_KEY=

# Comma-separated addresses for the other two delegates (edge node 2 and
# edge node 3). Leave unset for a local demo, where scripts/deploy.js
# defaults to Hardhat's own well-known local signers instead.
DELEGATE_ADDRESSES=
