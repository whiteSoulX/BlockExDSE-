# Copy this file to .env (local dev) or .env.production (cloud build) and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# JSON-RPC endpoint of the chain the contract is deployed to.
# Local Hardhat node (default, what start.sh uses): http://127.0.0.1:8545
# Public testnet: an RPC URL from a provider such as Infura/Alchemy/Ankr.
VITE_RPC_URL=http://127.0.0.1:8545

# Deployed BlockExDSE contract address. Overrides the address baked in by
# scripts/deploy-local.js (frontend/src/lib/contractAddress.json), which only
# exists for local Hardhat runs. Set this explicitly for any real deployment.
# VITE_CONTRACT_ADDRESS=0x...

# Human-readable chain name shown in the header.
VITE_CHAIN_NAME=Hardhat Local

# Comma-separated list of edge node base URLs, in node order (node 1 first).
VITE_EDGE_NODE_URLS=http://127.0.0.1:9001,http://127.0.0.1:9002,http://127.0.0.1:9003
